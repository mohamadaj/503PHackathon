{
  "title": "Compute throws / returns junk",
  "intro": {"idea": "compute throws for the default input.", "why": "w"},
  "controls": [{"id": "a", "type": "slider", "label": "a", "min": 0, "max": 10, "step": 1, "default": 5},
               {"id": "b", "type": "toggle", "label": "b", "default": false}],
  "compute": "function compute(state) { if (state.a >= 5) throw new Error('a too large'); if (state.b) return null; return {values: {a: state.a}}; }",
  "visuals": [{"type": "readouts", "title": "a", "items": [{"source": "values.a", "label": "a"}]}],
  "explorations": [{"title": "go below 5", "kind": "guided", "state": {"a": 2}, "change": "c", "observe": "o", "why": "w", "expect": [{"source": "values.a", "equals": 2}]},
                   {"title": "turn on b", "kind": "limitation", "state": {"a": 2, "b": true}, "change": "c", "observe": "o", "why": "w"}],
  "limitations": ["l"],
  "tests": [{"name": "throws", "state": {}, "expect": [{"source": "values.a", "equals": 5}]}, {"name": "ok", "state": {"a": 1}, "expect": [{"source": "values.a", "equals": 1}]}],
  "source": {"paper": "P", "supported": [], "simplifications": []}
}
