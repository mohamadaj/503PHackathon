  "compute": "function compute(state) {\n  return {\n    values: {good: state.a + state.b, nan: NaN, inf: Infinity, str: 'hello', nul: null},\n    series: {s: [1, '2', null, NaN, -3], x5: [0, 1, 2, 3, 4], y3: [1, 4, 9], empty: [], zeros: [0, 0, 0]},\n    matrices: {rag: [[1, 2, 3], [4], [NaN, -1, 2]], one: [[7]]},\n    tables: {t: {cols: ['x', 'y'], rows: [[1, 'a'], ['b<sub>2</sub>', null], [NaN]]}}\n  };\n}",
