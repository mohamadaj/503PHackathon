    {"type": "line", "title": "line bad x", "x_source": "series.empty", "series": [{"source": "series.y3", "label": "y"}]},
    {"type": "heatmap", "title": "ragged heatmap with NaN and negatives", "source": "matrices.rag", "row_sums": true},
    {"type": "heatmap", "title": "1x1 heatmap", "source": "matrices.one"},
